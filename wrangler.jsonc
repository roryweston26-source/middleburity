// Cloudflare config. Nothing here is secret; secrets are set with `npx wrangler secret put NAME`
// (ANTHROPIC_API_KEY, ACCESS_CODE, VISITOR_SALT) and never live in this file or in git.
// Locally, `npm run dev:cf` runs this same config on Cloudflare's own runtime, reading .dev.vars.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "middleburity",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  // Don't send wrangler's usage telemetry to Cloudflare (this project doesn't do telemetry).
  "send_metrics": false,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "middleburity",
      // From `npx wrangler d1 create middleburity` (created 2026-09-23). Not a secret: it
      // only works with this Cloudflare account's credentials.
      "database_id": "aecb6074-ab73-4c27-8bb8-188c17a54697"
    }
  ],
  "vars": {
    "MODEL": "claude-opus-5",
    // Spending protection (see src/limits.js). Change these, then redeploy.
    "DAILY_BUDGET_USD": "2",
    "RATE_PER_HOUR": "20",
    "RATE_PER_DAY": "60"
  }
}
