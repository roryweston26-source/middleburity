# Copy this file to .dev.vars and fill it in. .dev.vars is git-ignored, so keys never land in the repo.

# The model that writes answers. Production runs DeepSeek through OpenRouter (see wrangler.jsonc).
MODEL=deepseek/deepseek-v4.1-flash
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# Optional: pin one OpenRouter host, with no fallback.
OPENROUTER_PROVIDER=DeepInfra
# An OpenRouter key (https://openrouter.ai/keys). Set a credit limit on it there too.
OPENAI_COMPAT_API_KEY=

# Or use Claude: set MODEL to a Claude model (e.g. claude-opus-5) and add an Anthropic key.
# ANTHROPIC_API_KEY=
# low | medium | high. Default is low. Claude only; ignored on Haiku.
# EFFORT=low

# Optional. When set, the chat asks for this code (the home screen stays open).
# ACCESS_CODE=
